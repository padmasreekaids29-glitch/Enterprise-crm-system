# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection (Leave empty to auto-boot embedded MongoDB Memory Server for local preview)
MONGODB_URI=

# JWT Authentication
JWT_SECRET=nexora-enterprise-crm-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# CORS Origin (comma-separated origins when running frontend separately)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
